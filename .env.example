# Configuration Django
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False

# Clé secrète à générer avant le premier démarrage
DJANGO_SECRET_KEY=CHANGE_ME

# Hôtes autorisés à accéder à Django
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origines autorisées pour les requêtes CSRF
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Chemin de l'administration Django
DJANGO_ADMIN_URL=admin/

# Niveau de journalisation
DJANGO_LOG_LEVEL=INFO

# Configuration PostgreSQL
POSTGRES_DB=cafe_fidelite
POSTGRES_USER=cafe_user

# Mot de passe PostgreSQL à générer
POSTGRES_PASSWORD=CHANGE_ME

# Connexion Django à PostgreSQL
DATABASE_URL=postgresql://cafe_user:CHANGE_ME@db:5432/cafe_fidelite

# Durée de conservation des connexions à la base
CONN_MAX_AGE=60

# Sécurité HTTP locale
# À adapter lors du futur déploiement HTTPS
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# Désactivation de l'inscription publique
DJANGO_ACCOUNT_ALLOW_REGISTRATION=False

# Vérification du courriel
DJANGO_ACCOUNT_EMAIL_VERIFICATION=none

# Nombre de processus Gunicorn
GUNICORN_WORKERS=2